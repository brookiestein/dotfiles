/var/log/ulogd/*.log {
    sharedscripts
    missingok
    notifempty
    create 0640 ulogd ulogd
    postrotate
        [ -f /run/ulogd.pid ] && /bin/kill -HUP $(cat /run/ulogd.pid)
    endscript
}

/var/log/ulogd/ulogd.json {
    daily
    maxsize 200M
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    create 0640 root ulogd
    sharedscripts
    postrotate
	/usr/bin/systemctl kill --kill-who=main -s HUP ulogd.service > /dev/null 2>&1 || true
    endscript
}
