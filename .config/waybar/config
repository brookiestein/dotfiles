// -*- mode: js-json; js-indent-level: 4; -*-
{
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 4,
    "exclusive": true,
    "passthrough": false,
    "fixed-center": true,

    "modules-left": [
	"network",
	"custom/separator",
	"memory",
	"custom/separator",
	"cpu",
	"custom/separator",
	"hyprland/workspaces"
    ],

    "modules-center": [
	"mpd"
    ],

    "modules-right": [
	"tray",
	"custom/separator",
        "pulseaudio",
	"custom/separator",
        "pulseaudio#microphone",
	"custom/separator",
	"backlight",
	"custom/separator",
	"battery",
	"custom/separator",
	"clock",
	"custom/separator",
	"power-profiles-daemon",
	"custom/separator",
	"custom/power",
    ],

    "network": {
	"family": "ipv4",
	"format-wifi": "  {essid} ({signalStrength}%)",
	"format-ethernet": "  {ipaddr}",
	"tooltip-format-wifi": "  {ipaddr}/{cidr} via {gwaddr}",
	"tooltip-format-ethernet": "  {ipaddr}/{cidr} via {gwaddr}",
	"tooltip-format-disconnected": "Disconnected",
	"max-length": 50,
    },

    "cpu": {
	"interval": 1,
	"format": "󰻠 {usage:2}%",
	"states": {
	    "normal": 10,
	    "warning": 40,
	    "critical": 80
	}
    },

    "mpd": {
	"format": "󰎆 {title} 󰥔 ({elapsedTime:%M:%S}/{totalTime:%M:%S}) 󰎈 {songPosition} of {queueLength} {stateIcon} {consumeIcon}{randomIcon}{repeatIcon}{singleIcon}",
	"format-disconnected": "Disconnected 󰝛",
	"format-stopped": "{consumeIcon}{randomIcon}{repeatIcon}{singleIcon}No music playing 󰝛",
	"unknown-tag": "N/A",
	"interval": 5,
	"consume-icons": {
	    "on": "<span color=\"#f53c3c\">󰮯</span> ",
	    "off": " "
	},
	"random-icons": {
	    "on": " ",
	    "off": ""
	},
	"repeat-icons": {
	    "on": "󰑖 ",
	    "off": ""
	},
	"single-icons": {
	    "on": "󰑘 "
	},
	"state-icons": {
	    "paused": "",
	    "playing": ""
	},
	"tooltip-format": "MPD (connected) 󰎆",
	"tooltip-format-disconnected": "MPD (disconnected) 󰝛",
	"on-click": "mpc toggle",
	"on-click-right": "mpc next",
	"on-click-middle": "mpc stop",
	"on-scroll-up": "mpc volume +2",
	"on-scroll-down": "mpc volume -2",
	"max-length": 60
    },

    "memory": {
	"interval": 5,
	"format": " {0}%",
	"tooltip-format": "{used:0.1f}G used of {total:0.1f}G",
	"states": {
	    "normal": 10,
	    "warning": 40,
	    "critical": 80
	}
    },

    "tray": {
        "show-passive-items": true,
        "spacing": 10,
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " ",
        "format-icons": {
            "headphone": " ",
            "hands-free": "󰂑",
            "headset": "󰂑",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [" ", " ", " "],
    	},
        "on-click-middle": "pamixer -t",
        "on-click": "wpctl set-mute @DEFAULT_SINK@ toggle",
	"tooltip-format": "{source_desc} | {volume}%"
    },

    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": " {volume}%",
        "format-source-muted": " ",
        "on-click": "wpctl set-mute @DEFAULT_SOURCE@ toggle",
        "on-scroll-up": "wpctl ",
        "on-scroll-down": "",
        "tooltip-format": "{source_desc} | {source_volume}%",
    },

    "backlight": {
	"device": "intel_backlight",
	"format": "{icon}{percent}%",
	"format-icons": [" ", " "],
	"on-scroll-up": "xbacklight -inc 10",
	"on-scroll-down": "xbacklight -dec 10"
    },

    "battery": {
	"bat": "BAT1",
	"interval": 60,
	"states": {
	    "good": 95,
	    "warning": 30,
	    "critical": 15
	},

	"format-charging": " {capacity}%",
	"format": "{icon} {capacity}%",
	"format-icons": [
	    "",
	    "",
	    "",
	    "",
	    ""
	]
    },

    "custom/separator": {
        "format": "|",
        "tooltip": false,
    },

    "clock": {
	"interval": 1,
	"format": "{:%a %F %T}",
	"tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    "custom/power": {
        "tooltip": true,
	"tooltip-format": "Launch System Power Manager",
        "on-click": "spm &",
        "format": "⏻ ",
    },

    "power-profiles-daemon": {
  	"format": "{icon}",
  	"tooltip-format": "Power profile: {profile}\nDriver: {driver}",
  	"tooltip": true,
  	"format-icons": {
    	    "default": "",
    	    "performance": "",
    	    "balanced": " ",
    	    "power-saver": " "
  	}
    }
}
